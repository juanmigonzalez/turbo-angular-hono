{
  "name": "turbo-angular-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev": "turbo run dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,css,md,astro,json,mjs,yml,yaml}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,html,css,md,astro,json,mjs,yml,yaml}\"",
    "verify:fast": "pnpm check:architecture && pnpm lint && pnpm test",
    "verify": "pnpm format:check && pnpm verify:fast && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@12.4.2"
}
